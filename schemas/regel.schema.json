{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "regel",
  "title": "Afleidingsregel",
  "description": "Formele afleidingsregel in RegelSpraak-oriëntatie. Veldenset gebaseerd op Handleiding Wetsanalyse §3.5.2b en §3.6 (vier regeltypen) + Leidraad §3.8 productentabel #15. soort-enum is canoniek (4 typen); tussenresultaat-vlag en prioriteit-veld zijn projectconventies — zie kaders/projectconventies.md.",
  "type": "object",
  "required": ["regel-id", "naam", "soort", "bwb-id", "artikel", "lid", "peildatum", "geldigheid-van", "annotatie-id", "rechtsfeit-id", "invoer", "uitvoer", "operators", "formele-regel", "toelichting", "voorbeeldreeksen", "tussenresultaat"],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "Canon (HW §3.5.2b): een Specialisatieregel verwijst altijd naar de hoofdregel die zij overschrijft. gespecialiseerd-regel-id is daarom verplicht en niet-null bij soort=Specialisatieregel.",
      "if": { "properties": { "soort": { "const": "Specialisatieregel" } } },
      "then": {
        "required": ["gespecialiseerd-regel-id"],
        "properties": {
          "gespecialiseerd-regel-id": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "properties": {
    "regel-id": {
      "type": "string",
      "pattern": "^AR-BWBR[0-9]+-(?:art[0-9]+[a-z]?-lid[0-9]+|art[0-9]+[a-z]?-par[0-9]+|par[0-9]+-[0-9]+)-[a-z0-9]+$"
    },
    "naam": { "type": "string", "minLength": 1 },
    "soort": {
      "type": "string",
      "enum": ["Beslissingsregel", "Rekenregel", "Beperkingsregel", "Specialisatieregel"]
    },
    "bwb-id": { "type": "string", "pattern": "^BWBR[0-9]+$" },
    "artikel": { "type": "string" },
    "lid": { "type": "string" },
    "peildatum": { "type": "string", "format": "date" },
    "annotatie-id": {
      "type": "string",
      "description": "bronannotatie-id in pad-notatie, bijv. BWBR0004770/art9/lid1 of BWBR0024096/par9-1",
      "pattern": "^[A-Z0-9]+/(?:art[0-9]+[a-z]?/lid[0-9]+|par[0-9][0-9.-]*)$"
    },
    "rechtsfeit-id": { "type": ["string", "null"], "description": "begrip-id van triggerende rechtsfeit; null bij tussenresultaat" },
    "invoer": {
      "type": "array",
      "items": { "type": "string", "description": "begrip-id" }
    },
    "uitvoer": {
      "type": "array",
      "items": { "type": "string", "description": "begrip-id" },
      "minItems": 1
    },
    "operators": {
      "type": "array",
      "items": { "type": "string" }
    },
    "formele-regel": { "type": "string", "minLength": 1 },
    "toelichting": { "type": "string" },
    "voorbeeldreeksen": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["invoerwaarden", "verwachte-uitkomst", "juridisch-juist"],
        "properties": {
          "invoerwaarden": { "type": "string" },
          "verwachte-uitkomst": { "type": "string" },
          "juridisch-juist": { "type": "boolean" },
          "toelichting": { "type": ["string", "null"] }
        }
      }
    },
    "geldigheid-van": { "type": "string", "format": "date" },
    "geldigheid-tot": { "type": ["string", "null"], "format": "date" },
    "tussenresultaat": { "type": "boolean", "default": false },
    "prioriteit": { "type": ["integer", "null"], "description": "Uitvoeringsvolgorde bij meerdere toepasselijke Specialisatieregels; lager getal = hogere prioriteit; null bij overige regelsoorten" },
    "vervangt-regel-id": { "type": ["string", "null"] },
    "gespecialiseerd-regel-id": { "type": ["string", "null"], "description": "Regel-id van de hoofdregel waarvan deze Specialisatieregel afwijkt; verplicht voor soort 'Specialisatieregel', null bij overige regelsoorten" },
    "bronnen-secundair": {
      "type": "array",
      "description": "A3d: secundaire bronnen (Leidraad, beleidsregels, jurisprudentie, MvT, kamerstukken) die de regel mede vormgeven. Primaire bron blijft annotatie-id.",
      "items": {
        "type": "object",
        "required": ["soort", "vindplaats"],
        "additionalProperties": false,
        "properties": {
          "soort": {
            "type": "string",
            "enum": ["leidraad", "beleidsregel", "memorie-van-toelichting", "jurisprudentie", "kamerstukken", "ander"]
          },
          "vindplaats": { "type": "string", "minLength": 1 },
          "toelichting": { "type": ["string", "null"] }
        }
      }
    }
  }
}
