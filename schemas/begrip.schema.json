{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "begrip",
  "title": "Begrip",
  "description": "SKOS-compatibel begrip, afgeleid van JAS-annotatie",
  "type": "object",
  "required": ["begrip-id", "begripsnaam", "soort", "herkomst", "status", "definitie", "definitie-versie", "definitie-gebaseerd-op", "markeringen", "geldigheid-van", "relaties", "identificatiebegrip", "jas-klasse", "toelichting-klasse"],
  "additionalProperties": false,
  "properties": {
    "begrip-id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+/(?:art[0-9]+[a-z]?/lid[0-9]+|par[0-9][0-9.-]*)/[a-z0-9-]+$",
      "description": "Samengestelde ID: {bwb-id}/art{N}/lid{L}/{slug} of {bwb-id}/par{ref}/{slug}"
    },
    "begripsnaam": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" }, "default": [] },
    "soort": {
      "type": "string",
      "enum": ["monetair-bedrag", "percentage", "tijdsduur", "datum", "booleaans", "tekst", "enumeratie", "entiteit"]
    },
    "soort-id": {
      "type": "boolean",
      "description": "true als dit begrip dient als unieke sleutel (voorheen [id]-suffix)"
    },
    "herkomst": { "type": "string", "enum": ["direct", "afgeleid"] },
    "status": { "type": "string", "enum": ["concept", "ter-review", "gevalideerd", "vervallen", "te-verrijken"] },
    "definitie": {
      "type": "object",
      "description": "Gelaagde begripsdefiniëring: een universele kern plus optionele contextuele aanvullingen per wetsartikel.",
      "required": ["kern", "contexten"],
      "additionalProperties": false,
      "properties": {
        "kern": {
          "type": "string",
          "description": "De universele, wets-overstijgende betekenis — geldig voor alle bronartikelen. Leeg in stubs; ingevuld na /begrip."
        },
        "contexten": {
          "type": "array",
          "description": "Artikel-specifieke aanvullingen op de kern. Leeg als de kern voor alle bronnen volstaat.",
          "items": {
            "type": "object",
            "required": ["markering-id", "bijdrage", "tekst"],
            "additionalProperties": false,
            "properties": {
              "markering-id": {
                "type": "string",
                "minLength": 1,
                "description": "Verwijst naar markeringen[].markering-id in dit begrip-bestand."
              },
              "bijdrage": {
                "type": "string",
                "enum": ["verfijning", "uitbreiding", "uitzondering"],
                "description": "verfijning: specificeert de kern voor één wetscontext; uitbreiding: voegt nieuwe betekenisdimensie toe; uitzondering: beperkt of sluit de kern in een specifieke context uit."
              },
              "tekst": {
                "type": "string",
                "minLength": 1,
                "description": "De contextuele toevoeging in gewone juridische taal."
              },
              "toelichting": {
                "type": "string",
                "description": "Optionele juridische motivering van de keuze voor dit bijdrage-type."
              }
            }
          }
        }
      }
    },
    "definitie-versie": { "type": "integer", "minimum": 1 },
    "definitie-gebaseerd-op": {
      "type": "array",
      "description": "markering-id's die uitsluitend de kern staven (niet de contextlagen).",
      "items": { "type": "string" },
      "minItems": 1
    },
    "markeringen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["markering-id", "bron-annotatie-id", "tekst", "interpretatiemethode", "bijdrage", "bevestigd"],
        "additionalProperties": false,
        "properties": {
          "markering-id": { "type": "string" },
          "bron-annotatie-id": { "type": "string" },
          "tekst": { "type": "string", "minLength": 1 },
          "interpretatiemethode": {
            "type": "string",
            "enum": ["grammaticaal", "systematisch", "teleologisch", "wetshistorisch"]
          },
          "bijdrage": {
            "type": "string",
            "enum": ["primair", "aanvullend", "context"],
            "description": "primair: staving van de kern; aanvullend: verrijkt de kern vanuit meerdere bronartikelen; context: markeert aanwezigheid zonder betekenisbijdrage"
          },
          "bevestigd": { "type": "boolean" },
          "bevestigd-op": { "type": ["string", "null"], "format": "date" }
        }
      }
    },
    "geldigheid-van": { "type": "string", "format": "date" },
    "geldigheid-tot": {
      "oneOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ],
      "description": "Einddatum geldigheid (inclusief); null als nog geldig"
    },
    "vervangen-door": { "type": ["string", "null"], "description": "begrip-id van opvolger" },
    "relaties": {
      "type": "object",
      "required": ["is-een", "heeft", "leidt-tot"],
      "properties": {
        "is-een": {
          "type": "array",
          "items": { "type": "string", "description": "begrip-id" }
        },
        "heeft": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["begrip-id", "kardinaliteit"],
            "properties": {
              "begrip-id": { "type": "string" },
              "kardinaliteit": { "type": "string", "enum": ["1:1", "1:n", "n:m"] }
            }
          }
        },
        "leidt-tot": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["begrip-id", "relatie-soort"],
            "properties": {
              "begrip-id": { "type": "string" },
              "kardinaliteit": { "type": ["string", "null"] },
              "relatie-soort": { "type": "string", "enum": ["causaal", "procedureel", "definitoir"] }
            }
          }
        }
      }
    },
    "identificatiebegrip": {
      "type": "boolean",
      "description": "true als dit begrip een identificerend attribuut is van een entiteit (bijv. BSN voor belastingschuldige, aanslagnummer voor belastingaanslag). Zie ook soort-id, dat hetzelfde semantisch markeert; beide velden worden naast elkaar gebruikt voor backward-compatibiliteit."
    },
    "jas-klasse": {
      "type": "string",
      "description": "JAS-classificatie overgenomen uit de primaire annotatierij (A2). Wordt tijdens A3 niet gewijzigd.",
      "enum": [
        "rechtssubject", "rechtsobject", "rechtsbetrekking", "rechtsfeit",
        "voorwaarde", "afleidingsregel", "variabele", "variabelewaarde",
        "parameter", "parameterwaarde", "operator", "tijdsaanduiding",
        "plaatsaanduiding", "delegatiebevoegdheid", "delegatie-invulling", "brondefinitie"
      ]
    },
    "toelichting-klasse": {
      "type": "string",
      "description": "Juridische motivering van de JAS-classificatiekeuze"
    },
    "afleidingsregel-id": { "type": ["string", "null"] },
    "uitvoer-van-regel-id": {
      "type": ["string", "null"],
      "description": "Verwijst naar de regel die dit begrip als uitvoer voortbrengt. Uitsluitend voor begrippen met jas-klasse != afleidingsregel en herkomst = afgeleid. Voor jas-klasse: afleidingsregel wordt afleidingsregel-id gebruikt."
    },
    "tussenresultaat": { "type": "boolean", "default": false },
    "voorbeelden": {
      "type": "array",
      "description": "Concrete stellingen die de grenzen van het begrip toetsen (minimaal 2, waarvan minstens 1 grensgeval)",
      "items": {
        "type": "object",
        "required": ["stelling", "waar"],
        "additionalProperties": false,
        "properties": {
          "stelling": { "type": "string", "minLength": 1 },
          "waar": { "type": "boolean" },
          "toelichting": { "type": ["string", "null"] }
        }
      }
    },
    "kenmerken": {
      "type": "array",
      "description": "Juridische kenmerken of eigenschappen van het begrip",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
