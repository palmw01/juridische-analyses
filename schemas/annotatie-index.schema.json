{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "annotatie-index",
  "title": "Annotatie-index",
  "description": "Structuuranker voor een wetsartikel; verwijst naar lid-annotaties",
  "type": "object",
  "required": ["artikel-id", "bwb-id", "wet", "artikel", "peildatum", "structuurpositie", "leden-annotaties", "kruisreferenties"],
  "additionalProperties": false,
  "properties": {
    "artikel-id": {
      "type": "string",
      "description": "Samengestelde ID: {bwb-id}/art{N}",
      "pattern": "^[A-Z0-9]+/art[0-9]+[a-z]?$"
    },
    "bwb-id": { "type": "string", "pattern": "^BWBR[0-9]+$" },
    "wet": { "type": "string" },
    "artikel": { "type": "string" },
    "peildatum": { "type": "string", "format": "date" },
    "structuurpositie": { "type": "string" },
    "leden-annotaties": {
      "type": "array",
      "description": "Pad-notatie verwijzingen naar de lid-annotaties van dit artikel, bijv. 'BWBR0004770/art9/lid1'",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9]+/art[0-9]+[a-z]?/lid[0-9]+$"
      }
    },
    "kruisreferenties": {
      "type": "array",
      "description": "Hoog-niveau tekstverwijzingen op artikelniveau, bijv. 'Art. 2 IW 1990'. Verschilt van annotatie-lid kruisreferenties die gestructureerde objecten bevatten.",
      "items": { "type": "string" }
    },
    "delegatiestructuur": {
      "type": "array",
      "description": "Delegatiebevoegdheden op artikelniveau (zelfde formaat als annotatie-lid)",
      "items": {
        "type": "object",
        "required": ["omschrijving", "vindplaats", "type"],
        "additionalProperties": false,
        "properties": {
          "omschrijving": { "type": "string", "minLength": 1 },
          "vindplaats": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["Verplicht", "Facultatief"] },
          "invulling": { "type": ["string", "null"] },
          "vindplaats-invulling": { "type": ["string", "null"] }
        }
      }
    }
  }
}
