{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bron",
  "title": "Bronbestand (bronnen/)",
  "description": "Wettekst van één artikel of paragraaf, opgehaald via wettenbank-MCP en genormaliseerd opgeslagen in bronnen/. Veldenset is projectconventie: normalisatie van de wettenbank-MCP-respons (bwbId → bwb-id, toevoeging opgehaald-op). De wetstekst zelf is canonieke bron — zie verder kaders/projectconventies.md.",
  "type": "object",
  "required": [
    "bwb-id",
    "artikel",
    "opgehaald-op",
    "versiedatum",
    "citeertitel",
    "bronreferentie",
    "pad",
    "leden"
  ],
  "additionalProperties": false,
  "properties": {
    "bwb-id": {
      "type": "string",
      "pattern": "^BWBR[0-9]+$"
    },
    "artikel": {
      "type": "string",
      "minLength": 1
    },
    "opgehaald-op": {
      "type": "string",
      "format": "date"
    },
    "versiedatum": {
      "type": "string",
      "format": "date"
    },
    "citeertitel": {
      "type": "string"
    },
    "bronreferentie": {
      "type": "string"
    },
    "pad": {
      "type": "string"
    },
    "leden": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lid", "tekst"],
        "additionalProperties": false,
        "properties": {
          "lid": { "type": "string" },
          "tekst": { "type": "string" }
        }
      }
    },
    "sectie": {
      "type": "string"
    },
    "formaat": {
      "type": "string",
      "enum": ["plain", "markdown"]
    }
  }
}
