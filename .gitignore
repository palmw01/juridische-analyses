# OS / IDE
.DS_Store
.vscode/

# Lokale instellingen
.claude/settings.local.json
settings.json

# Obsidian — apparaatspecifieke UI-instellingen
.obsidian/appearance.json
.obsidian/core-plugins.json

# Gegenereerde HTML-renders
analyses/*.html

# Python bytecache
__pycache__/

# pytest / coverage artefacten
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Nested virtual environments
.claude/skills/*/.venv/
tools/.venv/

# Obsidian — per-apparaat state (niet tracken)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
# graph.json wordt wél getrackt: colorGroups zijn gedeelde JAS-configuratie
# Obsidian — plugin-cache en hot-reload
.obsidian/plugins/*/main.js
.obsidian/plugins/*/manifest.json
.obsidian/plugins/*/styles.css

# Gegenereerde build artifacts (kennisgraaf)
kennisgraaf/*.dot
kennisgraaf/*.pdf
kennisgraaf/*.ttl
kennisgraaf/*.gexf
kennisgraaf/*.graphml

# Gegenereerde statische webapp
webapp/

# SPARQL-engine bundle (gebouwd met esbuild, niet tracken)
.build/
sitegen/scripts/node_modules/
sitegen/scripts/package-lock.json
