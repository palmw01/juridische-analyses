      <node id="iw1990-art9" label="Art. 9 IW 1990" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="annotatie" />
          <attvalue for="1" value="annotatie" />
          <attvalue for="2" value="#CCCCCC" />
          <attvalue for="3" value="Art. 9 IW 1990" />
          <attvalue for="4" value="BWBR0004770" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="6" value="Hoofdstuk II Invordering in eerste aanleg &gt; Artikel 9" />
          <attvalue for="7" value="[]" />
        </attvalues>
      </node>
      <node id="belastingaanslag" label="belastingaanslag" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="rechtsobject" />
          <attvalue for="2" value="#70AD47" />
          <attvalue for="8" value="belastingaanslag" />
          <attvalue for="9" value="Een belastingaanslag" />
          <attvalue for="10" value="Art. 9 lid 1 IW 1990" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="11" value="grammaticaal" />
          <attvalue for="12" value="De belastingaanslag is het rechtsobject waaraan invorderbaarheid als rechtsgevolg wordt verbonden. Brondefinitie in art. 2 lid 1 onderdeel m IW 1990: omvat voorlopige aanslag, aanslag, uitnodiging tot betaling, navorderingsaanslag en naheffingsaanslag, alsmede de voorlopige conserverende aanslag, de conserverende aanslag en de conserverende navorderingsaanslag in de inkomstenbelasting en in de schenk- en erfbelasting." />
          <attvalue for="13" value="een door de inspecteur vastgesteld, formeel besluit dat de belastingschuld van een belastingschuldige vaststelt en de grondslag vormt voor invordering door de ontvanger" />
          <attvalue for="14" value="enumeratiewaarde [id]" />
          <attvalue for="15" value="direct" />
          <attvalue for="16" value="[]" />
          <attvalue for="17" value="2026-01-01" />
          <attvalue for="18" value="" />
          <attvalue for="19" value="concept" />
          <attvalue for="20" value="[]" />
          <attvalue for="21" value="['[[begrippen/dagtekening-aanslagbiljet]]']" />
          <attvalue for="22" value="['[[begrippen/invorderbaarheid]]']" />
        </attvalues>
      </node>
      <node id="dagtekening-aanslagbiljet" label="dagtekening-aanslagbiljet" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="rechtsfeit" />
          <attvalue for="2" value="#FFC000" />
          <attvalue for="8" value="dagtekening-aanslagbiljet" />
          <attvalue for="9" value="de dagtekening van het aanslagbiljet" />
          <attvalue for="10" value="Art. 9 lid 1 IW 1990" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="11" value="systematisch" />
          <attvalue for="12" value="Primair geclassificeerd als rechtsfeit (systematische interpretatie): de dagtekening is het tijdstip waaraan de aanvang van de invorderingstermijn als rechtsgevolg is verbonden — dagtekening creëert het recht tot invordering na zes weken. Tevens uitlegbaar als tijdsaanduiding (grammaticale interpretatie): de dagtekening fungeert als peildatum voor de berekening van het invorderingstijdstip. Brondefinitie van aanslagbiljet: art. 2 lid 2 onderdeel d IW 1990." />
          <attvalue for="13" value="de op het aanslagbiljet vermelde datum waarop de belastingaanslag door de inspecteur is vastgesteld en die de aanvang van de invorderingstermijn bepaalt" />
          <attvalue for="14" value="datum" />
          <attvalue for="15" value="direct" />
          <attvalue for="16" value="[]" />
          <attvalue for="17" value="2026-01-01" />
          <attvalue for="18" value="" />
          <attvalue for="19" value="concept" />
          <attvalue for="20" value="[]" />
          <attvalue for="21" value="[]" />
          <attvalue for="22" value="['[[begrippen/zes-weken-na-dagtekening-aanslagbiljet]]', '[[begrippen/invorderbaarheid]]']" />
        </attvalues>
      </node>
      <node id="invorderbaarheid-belastingaanslag" label="invorderbaarheid-belastingaanslag" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="afleidingsregel" />
          <attvalue for="2" value="#00B0F0" />
          <attvalue for="8" value="invorderbaarheid-belastingaanslag" />
          <attvalue for="9" value="Een belastingaanslag is invorderbaar zes weken na de dagtekening van het aanslagbiljet." />
          <attvalue for="10" value="Art. 9 lid 1 IW 1990" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="11" value="grammaticaal" />
          <attvalue for="12" value="De volledige zin vormt een afleidingsregel: uit de dagtekening van het aanslagbiljet plus zes weken volgt het tijdstip waarop invorderbaarheid intreedt. De regel combineert kenmerken van een beslissingsregel (invorderbaar ja/nee) en een rekenregel (berekening van het tijdstip)." />
          <attvalue for="13" value="de regel die bepaalt dat een belastingaanslag invorderbaar wordt op het tijdstip gelegen zes weken na de dagtekening van het aanslagbiljet" />
          <attvalue for="14" value="waar-niet-waar" />
          <attvalue for="15" value="afgeleid" />
          <attvalue for="16" value="[]" />
          <attvalue for="17" value="2026-01-01" />
          <attvalue for="18" value="" />
          <attvalue for="19" value="concept" />
          <attvalue for="20" value="['[[regels/AR-9-1]]']" />
          <attvalue for="21" value="['[[begrippen/belastingaanslag]]', '[[begrippen/dagtekening-aanslagbiljet]]', '[[begrippen/zes-weken-na-dagtekening-aanslagbiljet]]']" />
          <attvalue for="22" value="['[[begrippen/invorderbaarheid]]']" />
        </attvalues>
      </node>
      <node id="invorderbaarheid" label="invorderbaarheid" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="rechtsbetrekking" />
          <attvalue for="2" value="#FF0000" />
          <attvalue for="8" value="invorderbaarheid" />
          <attvalue for="9" value="is invorderbaar" />
          <attvalue for="10" value="Art. 9 lid 1 IW 1990" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="11" value="grammaticaal" />
          <attvalue for="12" value="De formulering 'is invorderbaar' drukt de rechtsbetrekking uit: het moment waarop de ontvanger bevoegd is tot invordering (rechthebbende) en de belastingschuldige verplicht is te betalen (plichthebbende). De rechtssubjecten zijn niet expliciet in lid 1 vernoemd; zij vloeien voort uit art. 2 lid 1 onderdeel k (belastingschuldige) en art. 3 lid 1 IW 1990 (ontvanger)." />
          <attvalue for="13" value="de juridische toestand waarin de ontvanger bevoegd is tot actieve invordering van een belastingaanslag en de belastingschuldige gehouden is tot betaling" />
          <attvalue for="14" value="waar-niet-waar" />
          <attvalue for="15" value="afgeleid" />
          <attvalue for="16" value="[]" />
          <attvalue for="17" value="2026-01-01" />
          <attvalue for="18" value="" />
          <attvalue for="19" value="concept" />
          <attvalue for="20" value="['[[regels/AR-9-1]]']" />
          <attvalue for="21" value="[]" />
          <attvalue for="23" value="['Art. 9 lid 1 IW 1990']" />
          <attvalue for="22" value="[]" />
        </attvalues>
      </node>
      <node id="zes-weken-na-dagtekening-aanslagbiljet" label="zes-weken-na-dagtekening-aanslagbiljet" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="tijdsaanduiding" />
          <attvalue for="2" value="#F4B942" />
          <attvalue for="8" value="zes-weken-na-dagtekening-aanslagbiljet" />
          <attvalue for="9" value="zes weken na de dagtekening van het aanslagbiljet" />
          <attvalue for="10" value="Art. 9 lid 1 IW 1990" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="11" value="grammaticaal" />
          <attvalue for="12" value="De gecombineerde uitdrukking duidt het tijdstip aan waarop invorderbaarheid van een reguliere belastingaanslag intreedt. Bestaat uit de parameter 'zes weken', de operator 'na' en de peildatum/het rechtsfeit 'de dagtekening van het aanslagbiljet'. Let op: art. 9 lid 10 IW 1990 sluit de Algemene termijnenwet uit — de termijn van zes weken loopt strikt kalendertechnisch door, ook bij weekenden en feestdagen." />
          <attvalue for="13" value="het tijdstip gelegen zes aaneengesloten weken na de dagtekening van het aanslagbiljet, berekend zonder toepassing van de Algemene termijnenwet, waarop een reguliere belastingaanslag invorderbaar wordt" />
          <attvalue for="14" value="datum" />
          <attvalue for="15" value="afgeleid" />
          <attvalue for="16" value="[]" />
          <attvalue for="17" value="2026-01-01" />
          <attvalue for="18" value="" />
          <attvalue for="19" value="concept" />
          <attvalue for="20" value="['[[regels/AR-9-1]]']" />
          <attvalue for="21" value="['[[begrippen/dagtekening-aanslagbiljet]]', '[[begrippen/zes-weken]]']" />
          <attvalue for="22" value="['[[begrippen/invorderbaarheid]]']" />
        </attvalues>
      </node>
      <node id="zes-weken" label="zes-weken" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="begrip" />
          <attvalue for="1" value="parameter" />
          <attvalue for="2" value="#FFD966" />
          <attvalue for="8" value="zes-weken" />
          <attvalue for="9" value="zes weken" />
          <attvalue for="10" value="Art. 9 lid 1 IW 1990" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="11" value="grammaticaal" />
          <attvalue for="12" value="De termijn 'zes weken' is een parameter: een constante waarde die voor alle reguliere belastingaanslagen gelijkelijk geldt, ongeacht belastingsoort, belastingplichtige of tijdvak. Afwijkende termijnen zijn vastgesteld in lid 2 (navorderingsaanslag: één maand; naheffingsaanslag: veertien dagen) en lid 4 (uitnodiging tot betaling: tien dagen). Art. 9 lid 10 IW 1990 sluit de Algemene termijnenwet uit." />
          <attvalue for="13" value="een vaste termijn van zes aaneengesloten weken (42 kalenderdagen), neergelegd in art. 9 lid 1 IW 1990 als standaard betalingstermijn voor reguliere belastingaanslagen" />
          <attvalue for="14" value="getal" />
          <attvalue for="15" value="direct" />
          <attvalue for="16" value="[]" />
          <attvalue for="17" value="2026-01-01" />
          <attvalue for="18" value="" />
          <attvalue for="19" value="concept" />
          <attvalue for="20" value="[]" />
          <attvalue for="21" value="[]" />
          <attvalue for="22" value="['[[begrippen/zes-weken-na-dagtekening-aanslagbiljet]]']" />
        </attvalues>
      </node>
      <node id="AR-9-1" label="bepalen invorderbaarheid belastingaanslag" start="2026-01-01">
        <attvalues>
          <attvalue for="0" value="afleidingsregel" />
          <attvalue for="1" value="afleidingsregel" />
          <attvalue for="2" value="#00B0F0" />
          <attvalue for="24" value="AR-9-1" />
          <attvalue for="25" value="bepalen invorderbaarheid belastingaanslag" />
          <attvalue for="14" value="Beslissingsregel" />
          <attvalue for="5" value="2026-01-01" />
          <attvalue for="26" value="['plus', 'groter-dan-of-gelijk-aan']" />
        </attvalues>
      </node>
